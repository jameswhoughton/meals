{{define "body"}}
<div class="bg-zinc-800 p-6 rounded-md shadow-md w-full h-full">
	<h1 class="text-xl mb-6">Edit Tag</h1>
	<alert-message class="mb-3" data-variation="info">Any changes here will affect all meals that use this tag</alert-message>
	<form action="/tags/{{.Form.Id}}" method="post">
		<div class="flex flex-col gap-2 mb-4">
		    <label class="text-sm text-slate-300" for="name">name</label>
		    <input class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" type="text" name="name"
			value="{{.Form.Name}}" />
		    {{if .Form.Errors.Name}}<div class="text-sm text-red-400">{{.Form.Errors.Name}}</div>{{end}}
		</div>
		<button class="py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto" type="submit">Update</button>
	</form>
</div>

<script src="/static/components/alertMessage.js"></script>
{{end}}
