{{define "body"}}
<div class="bg-zinc-800 p-6 rounded-md shadow-md w-full h-full">
	<h1 class="text-xl mb-6">Tags</h1>
	<div class="flex justify-end mb-4">
		<form action="/tags" method="get" class="mb-0 flex gap-2">
			<input class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" name="query" placeholder="Search" value="{{.SearchQuery}}" />
			<button class="py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto">Search</button>
		</form>
	</div>
	{{if gt (len .Tags) 0}}
	<table class="w-full text-sm text-left rtl:text-right">
		<thead class="uppercase bg-zinc-700">
			<tr>
				<td class="px-6 py-3">Id</td>
				<td class="px-6 py-3">Name</td>
				<td class="px-6 py-3"></td>
			</tr>
		</thead>
		<tbody>
			{{range $tag := .Tags}}
			<tr class="border-b bg-zinc-800 border-zinc-600">
				<td class="px-6 py-4">{{$tag.Id}}</td>
				<td class="px-6 py-4">{{$tag.Name}}</td>
				<td class="px-6 py-4">
					<a class="text-cyan-400 hover:text-cyan-500 transition-colors underline" href="/tags/{{$tag.Id}}">Edit</a>
				</td>
			</tr>
			{{end}}
		</tbody>
	</table>
	{{else}}
	<div class="bg-zinc-700 h-[400px] rounded flex items-center justify-center">
		<div class="flex flex-col gap-8 items-center">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-24">
			  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
			</svg>
			<h2 class="text-2xl">No tags</h2>
			{{if eq .SearchQuery ""}}
			<p>There are no meals in the system, <a class="text-cyan-400 hover:text-cyan-500 transition-colors underline" href="/meals/create">create a meal</a> to add tags.
			{{else}}
			<p>Try a different search.</p>
			{{end}}
		</div>
	</div>
	{{end}}
</div>
{{end}}
