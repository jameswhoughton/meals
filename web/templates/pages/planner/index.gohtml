{{define "body"}}
<div class="bg-zinc-800 pb-12 rounded-md shadow-md w-full h-full">
    <h1 class="text-2xl p-6 border-b border-zinc-700 mb-8">{{.Title}}</h1>
    <div class="px-6">
        <div class="flex justify-between items-center mb-4">
            <a class="py-2 px-4 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto" href="/planner?date={{.Previous}}">Previous week</a>
            <a class="py-2 px-4 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto" href="/planner?date={{.Next}}">Next week</a>
        </div>
        <div class="flex flex-wrap gap-3 w-full">
            {{range .Days}}
            <div class="grow border border-zinc-600 rounded p-3 flex flex-col justify-between min-h-48">
                <div class="">{{.Label}}</div>
                {{if .Meal}}
                <div>{{.Meal.Name}}</div>
                {{end}}
                <a href="/planner/{{.Date}}" class="self-end justify-end hover:bg-slate-700 transition-colors rounded-md p-1">
                    <img class="w-6 h-6" src="/static/icons/edit.svg" alt="Edit day" />
                </a>
            </div>
            {{end}}
        </div>
    </div>
</div>
{{end}}
