{{define "body"}}
<div class="bg-zinc-800 p-6 rounded-md shadow-md w-full h-full">
    <h1 class="text-xl mb-6">Create a Meal</h1>
    <form method="post" action="/meals/create" class="mb-0">
        <div class="flex flex-col gap-2 mb-4">
            <label class="text-sm text-slate-300" for="name">name</label>
            <input class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" type="text" name="name"
                value="{{.Form.Name}}" />
            {{if .Form.Errors.Name}}<div class="text-sm text-red-400">{{.Form.Errors.Name}}</div>{{end}}
        </div>
        <div class="flex flex-col gap-2 mb-4">
            <label class="text-sm text-slate-300" for="notes">notes</label>
            <textarea class="rounded bg-zinc-700 ring-1 ring-zinc-400 w-[400px] min-h-[100px]" name="notes">{{.Form.Notes}}</textarea>
        </div>
        <div class="flex flex-col gap-3">
            <h2 class="border-b text-lg py-3">Attributes</h2>
            <label class="flex gap-2">
                <input type="checkbox" name="quick" value="1" />
                <span>quick</span>
            </label>
            <label class="flex gap-2">
                <input type="checkbox" name="easy" value="1" />
                <span>easy</span>
            </label>
            <label class="flex gap-2">
                <input type="checkbox" name="family" value="1" />
                <span>family</span>
            </label>
        </div>
        <div id="ingredients" class="flex flex-col gap-3 mb-4">
            <div class="border-b flex items-center justify-between">
                <h2 class="text-lg py-3">Ingredients</h2>
                <div class="flex gap-4 items-center mb-2">
                    <div class="flex flex-col">
                        <input 
                            id="input-ingredient-search"
                            class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]"
                            onkeyup="searchIngredients(this)"
                            placeholder="Find an existing ingredient"
                        />
                        <div class="relative">
                            <ul id="ingredient-results" class="hidden absolute top-[5px] bg-slate-500 left-0 right-0 rounded">
                            </ul>
                        </div>
                    </div>
                    <span>&mdash; or &mdash;</span>
                    <button class="py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto" type="button" onclick="addIngredient()">Add new ingredient</button>
                </div>
            </div>
            {{if .Form.Errors.Ingredients}}<div class="text-sm text-red-400">{{.Form.Errors.Ingredients}}</div>{{end}}
            {{range $i, $ingredient := .Form.Ingredients}}
            <meal-ingredient
                data-index="{{$i}}"
                data-id="{{$ingredient.Id}}"
                data-name="{{$ingredient.Name}}"
                data-quantity="{{$ingredient.Quantity}}"
                data-unit="{{$ingredient.Unit}}"
            ></meal-ingredient>
            {{end}}
        </div>
        <button class="py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto"
            type="submit">Create</button>
    </form>
</div>
<template id="ingredient-template">
    <div class="flex items-center gap-4 wrap">
        <div class="flex flex-col gap-2">
            <label class="text-sm text-slate-300" for="notes">name</label>
            <input name="ingredientName" class="name | py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px] disabled:bg-zinc-500" />
            <input name="ingredientId" value="0" type="hidden" />
        </div>
        <div class="flex flex-col gap-2">
            <label class="text-sm text-slate-300" for="notes">quantity</label>
            <input name="ingredientQuantity" class="quantity | py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" />
        </div>
        <div class="flex flex-col gap-2">
            <label class="text-sm text-slate-300" for="notes">unit</label>
            <input name="ingredientUnit" class="unit | py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" />
        </div>
        <label class="flex gap-2 self-end">
            <input type="radio" name="isMain" />
            <span>Main Ingredient</span>
        </label>
        <button class="remove-ingredient | py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto self-end">remove</button>
    </div>
</template>


<template id="ingredient-result-template">
    <li class="label | cursor-pointer px-2 py-3 hover:bg-slate-600 transition-colors"></li>
</template>

<script>
function addIngredient(ingredient) {
    const node = document.createElement('meal-ingredient')
    const ingredientCount = document.querySelectorAll('meal-ingredient').length

    node.dataset.index = ingredientCount

    if (ingredient !== undefined) {
        node.dataset.id = ingredient.id
        node.dataset.name = ingredient.label
    }

    document.getElementById('ingredients').append(node)
}

customElements.define(
    'meal-ingredient',
    class extends HTMLElement {
        constructor() {
            super()
        }

        template() {
            const node = document.createElement('div')

            node.classList.add('flex', 'items-center', 'gap-4', 'wrap')
            node.innerHTML = `
            <div class="flex flex-col gap-2">
                <label class="text-sm text-slate-300" for="notes">name</label>
                <input name="ingredientName" class="name | py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px] disabled:bg-zinc-500" />
                <input name="ingredientId" value="0" type="hidden" />
            </div>
            <div class="flex flex-col gap-2">
                <label class="text-sm text-slate-300" for="notes">quantity</label>
                <input name="ingredientQuantity" class="quantity | py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" />
            </div>
            <div class="flex flex-col gap-2">
                <label class="text-sm text-slate-300" for="notes">unit</label>
                <input name="ingredientUnit" class="unit | py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" />
            </div>
            <label class="flex gap-2 self-end">
                <input type="radio" name="isMain" />
                <span>Main Ingredient</span>
            </label>
            <button class="remove-ingredient | py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto self-end">remove</button>
            `

            return node
        }

        connectedCallback() {
            //const template = document.getElementById(
            //    "ingredient-template",
            //).content.cloneNode(true)

            const template = this.template()

            const index = this.getAttribute('data-index')

            const nameEl = template.querySelector('.name')

            nameEl.value = this.getAttribute('data-name')
            template.querySelector('.quantity').value = this.getAttribute('data-quantity')
            template.querySelector('.unit').value = this.getAttribute('data-unit')
            template.querySelector('[name="isMain"]').value = index

            const id = this.getAttribute('data-id')

            if (id !== null) {
                template.querySelector('[name="ingredientId"]').value = id
                nameEl.disabled = true
            }

            template.querySelector('.remove-ingredient').onclick = () => {
                document.querySelector('meal-ingredient[data-index="' + index + '"]').remove()
            }

            this.appendChild(template)
        }
    }
)

customElements.define(
    'ingredient-result',
    class extends HTMLElement {
        constructor() {
            super()
        }

        connectedCallback() {
            const template = document.getElementById(
                "ingredient-result-template",
            ).content.cloneNode(true)

            const id = this.getAttribute('data-id')
            const label = this.getAttribute('data-label')

            template.querySelector('.label').innerText = label
            template.querySelector('.label').onclick = () => {
                addIngredient({ id, label })

                const resultsContainer = document.getElementById('ingredient-results')
                const input = document.getElementById('input-ingredient-search')
                input.value = ''

                resultsContainer.classList.add('hidden')
            }

            this.appendChild(template)
        }
    }
)

let requestController = null

async function searchIngredients(input) {
    const query = input.value

    if (requestController !== null) {
        requestController.abort()
    }

    requestController = new AbortController

    const response = await fetch('http://localhost:8000/api/ingredients?query=' + query, {
        signal: requestController.signal
    })

    const results = await response.json()

    const resultsContainer = document.getElementById('ingredient-results')

    resultsContainer.innerHTML = ''

    results.forEach(result => {
        const node = document.createElement('ingredient-result')

        node.dataset.id = result.id
        node.dataset.label = result.name

        resultsContainer.append(node)
    })

    resultsContainer.classList.remove('hidden')
}
</script>
{{end}}
