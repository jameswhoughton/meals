{{define "body"}}
<div class="bg-zinc-800 p-6 rounded-md shadow-md w-full h-full">
    <h1 class="text-xl mb-6">Create a Meal</h1>
    <form method="post" action="/meals/create" class="mb-0">
        <div class="flex flex-col gap-2 mb-4">
            <label class="text-sm text-slate-300" for="name">name</label>
            <input class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" type="text" name="name"
                value="{{.Form.Name}}" />
            {{if .Form.Errors.Name}}<div class="text-sm text-red-400">{{.Form.Errors.Name}}</div>{{end}}
        </div>
        <div class="flex flex-col gap-2 mb-4">
            <label class="text-sm text-slate-300" for="notes">notes</label>
            <textarea class="rounded bg-zinc-700 ring-1 ring-zinc-400 w-[400px] min-h-[100px]" name="notes">{{.Form.Notes}}</textarea>
        </div>
        <div class="flex flex-col gap-3">
            <h2 class="border-b text-lg py-3">Attributes</h2>
            <label class="flex gap-2">
                <input type="checkbox" name="quick" value="1" />
                <span>quick</span>
            </label>
            <label class="flex gap-2">
                <input type="checkbox" name="easy" value="1" />
                <span>easy</span>
            </label>
            <label class="flex gap-2">
                <input type="checkbox" name="family" value="1" />
                <span>family</span>
            </label>
        </div>
        <div id="ingredients" class="flex flex-col gap-3 mb-4">
            <div class="border-b flex items-center justify-between">
                <h2 class="text-lg py-3">Ingredients</h2>
                <div class="flex gap-4 items-center mb-2">
                    <div class="flex flex-col">
                        <request-typeahead
                            id="input-ingredient-search"
                            data-placeholder="Find an existing ingredient"
                            data-url="http://localhost:8000/api/ingredients"
                        />
                    </div>
                    <span>&mdash; or &mdash;</span>
                    <button 
                        class="py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto"
                        type="button"
                        onclick="addIngredient()"
                    >Add new ingredient</button>
                </div>
            </div>
            {{if .Form.Errors.Ingredients}}<div class="text-sm text-red-400">{{.Form.Errors.Ingredients}}</div>{{end}}
            {{range $i, $ingredient := .Form.Ingredients}}
            <meal-ingredient
                data-index="{{$i}}"
                data-id="{{$ingredient.Id}}"
                data-name="{{$ingredient.Name}}"
                data-quantity="{{$ingredient.Quantity}}"
                data-unit="{{$ingredient.Unit}}"
            ></meal-ingredient>
            {{end}}
        </div>
        <button class="py-2 px-1.5 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto"
            type="submit">Create</button>
    </form>
</div>

<script src="/static/components/mealIngredient.js"></script>
<script src="/static/components/requestTypeahead.js"></script>
<script>
function addIngredient(ingredient) {
    const node = document.createElement('meal-ingredient')
    const ingredientCount = document.querySelectorAll('meal-ingredient').length

    node.dataset.index = ingredientCount

    if (ingredient !== undefined) {
        node.dataset.id = ingredient.id
        node.dataset.name = ingredient.label
    }

    document.getElementById('ingredients').append(node)
}

const ingredientTypeahead = document.getElementById('input-ingredient-search')

ingredientTypeahead.addEventListener('selected', (e) => addIngredient(e.detail))
</script>
{{end}}
