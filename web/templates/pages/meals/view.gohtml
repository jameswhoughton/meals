{{define "body"}}
<div class="bg-zinc-800 rounded-md shadow-md w-full h-full">
    <div class="p-6 border-b border-zinc-700 mb-8 flex justify-between items-center">
        <h1 class="text-2xl ">{{.Title}}</h1>
        <div class="flex items-center gap-3">
            <a href="/meals/{{.Meal.Id}}/edit" class="py-2 px-4 rounded-md text-cyan-600 hover:text-slate-300 hover:bg-cyan-900 transition-colors w-auto border border-cyan-600 hover:border-cyan-900">Edit</a>
            <form method="post" action="/meals/{{.Meal.Id}}/delete">
                <button class="py-2 px-4 rounded-md text-red-400 hover:text-slate-300 hover:bg-red-900 transition-colors border border-red-400 hover:border-red-900" type="submit">Delete<button>
            </form>
        </div>
    </div>

    <div class="px-6 pb-6">
        <div class="flex flex-wrap gap-3 mb-8">
            {{range .Meal.Tags}}
                <span class="border border-slate-300 py-1 px-2 rounded-lg text-sm">{{.Name}}</span>
            {{end}}
        </div>

        {{if .Meal.Ingredients}}
        <div class="mt-8 max-w-72">
            <h2 class="text-xl mb-4">Ingredients</h2>
            {{range .Meal.Ingredients}}
            <div class="flex justify-between w-full">
                <span>{{.Name}}</span>
                <span>{{.Quantity}}{{.Unit}}</span>
            </div>
            {{end}}
        </div>
        {{end}}

        {{if .Meal.Notes}}
        <div class="mt-8">
            <h2 class="text-xl mb-4">Notes</h2>
            <p class="whitespace-pre">{{.Meal.Notes}}</p>
        </div>
        {{end}}
    </div>
</div>
{{end}}
