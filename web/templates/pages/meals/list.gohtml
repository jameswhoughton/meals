{{define "body"}}
<div class="bg-zinc-800 pb-12 rounded-md shadow-md w-full h-full">
	<div class="p-6 border-b border-zinc-700 mb-8 flex items-center justify-between">
		<h1 class="text-2xl">My Meals</h1>
		<a class="py-2 px-4 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto" href="/meals/create">Create</a>
	</div>
	<div class="px-6">
		<div class="flex justify-end mb-4">
			<form action="/meals" method="get" class="mb-0 flex gap-2">
				<input class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-400 w-[250px]" name="query" placeholder="Search" value="{{.SearchQuery}}" />
				<button class="py-2 px-4 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors w-auto">Search</button>
			</form>
		</div>
		{{if gt (len .Meals) 0}}
		<table class="w-full text-sm text-left rtl:text-right">
			<thead class="uppercase bg-zinc-700">
				<tr>
					<td class="px-6 py-3">Id</td>
					<td class="px-6 py-3">Name</td>
					<td class="px-6 py-3"></td>
				</tr>
			</thead>
			<tbody>
				{{range $meal := .Meals}}
				<tr class="border-b bg-zinc-800 border-zinc-600">
					<td class="px-6 py-4">{{$meal.Id}}</td>
					<td class="px-6 py-4"><a class="text-cyan-400 hover:text-cyan-500 transition-colors underline" href="/meals/{{$meal.Id}}">{{$meal.Name}}</a></td>
					<td class="px-6 py-4 flex justify-end gap-3">
						<a href="/meals/{{$meal.Id}}/edit" class="py-2 px-4 rounded-md text-cyan-600 hover:text-slate-300 hover:bg-cyan-900 transition-colors w-auto border border-cyan-600 hover:border-cyan-900">Edit</a>
						<form method="post" action="/meals/{{$meal.Id}}/delete">
							<button class="py-2 px-4 rounded-md text-red-400 hover:text-slate-300 hover:bg-red-900 transition-colors border border-red-400 hover:border-red-900" type="submit">Delete<button>
						</form>
					</td>
				</tr>
				{{end}}
			</tbody>
		</table>
		{{else}}
		<div class="bg-zinc-700 h-[400px] rounded flex items-center justify-center">
			<div class="flex flex-col gap-8 items-center">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-24">
				  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
				</svg>
				<h2 class="text-2xl">No Meals</h2>
				{{if eq .SearchQuery ""}}
				<p>There are no meals in the system, Use the 'create a meal' button to get started.
				{{else}}
				<p>Try a different search.</p>
				{{end}}
			</div>
		</div>
		{{end}}
	</div>
</div>
{{end}}
