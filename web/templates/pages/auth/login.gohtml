{{define "yield"}}
<div class="flex justify-center mb-3">
    <img src="/static/icons/logo.svg" class="w-24" />
</div>
{{if .Success}}
    <alert-message class="mb-3" data-variation="success">{{.Success}}</alert-message>
{{end}}
{{if .Error}}
    <alert-message class="mb-3" data-variation="danger">{{.Error}}</alert-message>
{{end}}
<form method="post" action="/login" class="flex flex-col gap-4 mb-0">
    <div class="flex flex-col gap-1">
        <label class="text-sm text-slate-300" for="email">email</label>
        <input class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-600" type="text" name="email" />
    </div>
    <div class="flex flex-col gap-1">
        <label class="text-sm text-slate-300" for="password">password</label>
        <input class="py-2 px-1.5 rounded bg-zinc-700 ring-1 ring-zinc-600" type="password" name="password" />
    </div>
    <button class="py-2 px-4 rounded-md bg-cyan-800 hover:bg-cyan-900 transition-colors" type="submit">Login</button>
</form>
<script src="/static/components/alertMessage.js"></script>
{{end}}

{{define "formFooter"}}
Don't have an account? <a href="/register" class="text-cyan-600 hover:text-cyan-700 transition-colors">Register here</a>
{{end}}
